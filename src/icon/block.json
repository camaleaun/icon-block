{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "camaleaun/icon",
	"version": "1.1.0",
	"title": "Ícone",
	"category": "widgets",
	"icon": "smiley",
	"example": {},
	"attributes": {},
	"supports": {
		"html": true,
		"__experimentalBorder": {
			"radius": true,
