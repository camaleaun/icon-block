			"margin": true
		},
		"border-radius": true,
		"typography": {
			"fontSize": true
		}
	},
	"allowedBlocks": [ "camaleaun/icon-path" ],
	"textdomain": "camaleaun",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
